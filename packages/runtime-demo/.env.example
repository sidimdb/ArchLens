# Demo configuration for @archlens/runtime cloud sync.
#
# Copy this file to `.env` (gitignored) and fill in real values. Expo
# automatically exposes any variable prefixed with EXPO_PUBLIC_ to the
# JS bundle at build time.

# Base URL of the ArchLens cloud API. For local development point this
# at your laptop's LAN IP (so the phone can reach it on the same Wi-Fi),
# e.g. http://192.168.1.42:3000. In production, the deployed API URL.
EXPO_PUBLIC_ARCHLENS_API_URL=

# A project key created in the dashboard (or seeded via SQL for the
# demo). Looks like: archlens_pk_live_<hex>
EXPO_PUBLIC_ARCHLENS_PROJECT_KEY=
