# ArchLens Cloud API — environment configuration.
#
# Copy this file to `.env` (gitignored) and fill in real values for
# local development. In production these come from the host (Render,
# Fly.io, Railway, etc.) environment.

# What port to bind on locally.
PORT=3000

# The Supabase project URL.
SUPABASE_URL=https://hfadouhihvcpsalxnyzf.supabase.co

# The Supabase service_role key. NEVER commit this. NEVER share it.
# It bypasses Row-Level Security and can read/write any data in the
# project. Lives only on the server.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated origins allowed by CORS. The runtime SDK doesn't run
# in a browser so CORS isn't strictly required for it, but the future
# dashboard will need this. Use "*" only for local development.
ALLOWED_ORIGINS=*
